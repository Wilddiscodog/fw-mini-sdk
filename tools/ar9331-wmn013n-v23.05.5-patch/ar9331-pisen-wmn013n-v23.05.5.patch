diff --git a/target/linux/ath79/dts/ar9331_pisen_wmn013n.dts b/target/linux/ath79/dts/ar9331_pisen_wmn013n.dts
new file mode 100644
index 0000000000..952c2621aa
--- /dev/null
+++ b/target/linux/ath79/dts/ar9331_pisen_wmn013n.dts
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include "ar9331.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Pisen WMN013N";
+	compatible = "pisen,wmn013n", "qca,ar9331";
+
+	aliases {
+		led-boot = &led_system;
+		led-failsafe = &led_system;
+		led-running = &led_system;
+		led-upgrade = &led_system;
+		label-mac-device = &eth0;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		led_system: led-0 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&gpio 27 GPIO_ACTIVE_LOW>;   /* 你的板: 系统灯在 GPIO27 */
+			default-state = "on";
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&gpio 11 GPIO_ACTIVE_LOW>;   /* 你的板: reset 在 GPIO11 */
+			debounce-interval = <60>;
+		};
+	};
+
+	/*
+	 * GPIO8 = USB VBUS 供电使能. USB 改用 generic-ehci 后不走 vbus-supply,
+	 * 改用 gpio-hog(见文件末尾 &gpio)开机直接钉高, U盘常供电.
+	 */
+};
+
+&spi {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x020000>;
+				read-only;
+				compatible = "nvmem-cells";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				macaddr_uboot_1fc00: macaddr@1fc00 {
+					reg = <0x1fc00 0x6>;         /* 你的网口 MAC 3c:40:4f:04:28:20 */
+				};
+			};
+
+			partition@20000 {
+				compatible = "tplink,firmware";
+				label = "firmware";
+				reg = <0x020000 0xfd0000>;        /* 16M: 0x20000..0xff0000 */
+			};
+
+			art: partition@ff0000 {
+				label = "art";
+				reg = <0xff0000 0x010000>;        /* ART 移到 16M 末尾(那份拷贝就在这) */
+				read-only;
+				compatible = "nvmem-cells";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				cal_art_1000: calibration@1000 {
+					reg = <0x1000 0x440>;
+				};
+			};
+		};
+	};
+};
+
+&eth0 {
+	status = "okay";
+
+	nvmem-cells = <&macaddr_uboot_1fc00>;
+	nvmem-cell-names = "mac-address";
+
+	gmac-config {
+		device = <&gmac>;
+
+		switch-phy-addr-swap = <0>;
+		switch-phy-swap = <0>;
+	};
+};
+
+&eth1 {
+	status = "okay";
+	compatible = "syscon", "simple-mfd";
+};
+
+&wmac {
+	status = "okay";
+	nvmem-cells = <&cal_art_1000>, <&macaddr_uboot_1fc00>;
+	nvmem-cell-names = "calibration", "mac-address";
+};
+
+&usb {
+	/*
+	 * AR9331 这颗是 Synopsys EHCI 核: 用 generic-ehci(与原厂 ar71xx 及 qca953x 一致),
+	 * 不用 ar9330.dtsi 默认的 chipidea —— chipidea 的 generic glue 不解除 usb-host
+	 * reset/时钟, 导致 DCCPARAMS 读 0 "doesn't support host". ehci-platform 会 deassert
+	 * reset + 使能时钟, 控制器才能起 host. caps-offset=0x100 处理 Synopsys HC 偏移.
+	 */
+	compatible = "generic-ehci";
+	reg = <0x1b000000 0x1000>;
+	caps-offset = <0x100>;
+	has-transaction-translator;
+	dr_mode = "host";
+	status = "okay";
+};
+
+&gpio {
+	usb_power {
+		gpio-hog;
+		gpios = <8 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb-power";
+	};
+};
+
+&usb_phy {
+	status = "okay";
+};
\ No newline at end of file
