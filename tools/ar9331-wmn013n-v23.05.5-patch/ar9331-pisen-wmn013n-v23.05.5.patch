+#!/bin/sh
+# datahub: 配置 ksmbd (SMB网络备份共享 \\IP\hub, 账号 hub)
+# 共享整个 hub 目录(含 datahub.db.bak 快照), 绑定 lan+wwan, 仅家庭网段可达(见防火墙)。
+
+[ -f /etc/config/ksmbd ] || exit 0
+
+# 共享接口: 管理AP(lan) + 家庭网(wwan)
+uci -q set ksmbd.@globals[0].interface='lan wwan'
+
+# hub 共享 (幂等: 先删同名再建)
+uci -q delete ksmbd.hub
+uci set ksmbd.hub=share
+uci set ksmbd.hub.name='hub'
+uci set ksmbd.hub.path='/mnt/sda1/hub'
+uci set ksmbd.hub.read_only='no'
+uci set ksmbd.hub.force_root='1'
+uci set ksmbd.hub.users='hub'
+uci set ksmbd.hub.create_mask='0644'
+uci set ksmbd.hub.dir_mask='0755'
+uci commit ksmbd
+
+# SMB 账号: hub / hyundai415 (幂等)
+if ! grep -q '^hub:' /etc/ksmbd/ksmbdpwd 2>/dev/null; then
+	ksmbd.adduser -u hub -p hyundai415 2>/dev/null || \
+		logger -t datahub "ksmbd.adduser 失败, 请手动: ksmbd.adduser -u hub -p <密码>"
+fi
+
+exit 0
diff --git a/package/luci-app-datahub/root/usr/bin/hub-announce b/package/luci-app-datahub/root/usr/bin/hub-announce
new file mode 100755
index 0000000000..f837e17c60
--- /dev/null
+++ b/package/luci-app-datahub/root/usr/bin/hub-announce
@@ -0,0 +1,16 @@
+#!/bin/sh
+# hub-announce — datahub UDP 广播发现应答器 (端口 3722, socat 实现)
+#
+# 局域网设备(手表/播放器)广播 "DISCOVER" → 本机应答 "DATAHUB <IP> <APIkey>"
+#   → 设备端零配置: 不用写死 hub IP/key
+# 协议刻意极简(不带请求方地址): socat 的 RECVFROM+fork 把应答自动回给发送方
+#
+# 为什么不用 mDNS: 家庭主路由的 IGMP snooping 常把组播拦在无线 STA 之间;
+# UDP 广播帧在 WiFi 上必达(与 ARP/DHCP 同级)。
+
+PORT=3722
+export DATAHUB_KEY=$(uci -q get datahub.hub.key)
+
+logger -t hub-announce "discovery responder on udp/$PORT"
+
+exec socat -T3 UDP-RECVFROM:$PORT,fork EXEC:/usr/bin/hub-announce-reply
diff --git a/package/luci-app-datahub/root/usr/bin/hub-announce-reply b/package/luci-app-datahub/root/usr/bin/hub-announce-reply
new file mode 100755
index 0000000000..6727f00c92
--- /dev/null
+++ b/package/luci-app-datahub/root/usr/bin/hub-announce-reply
@@ -0,0 +1,16 @@
+#!/bin/sh
+# hub-announce-reply — socat 子进程: stdin=收到的包, stdout=应答(自动回给发送方)
+# 环境变量 DATAHUB_KEY 由 hub-announce 导入
+
+req=$(head -c 32)
+case "$req" in
+DISCOVER*)
+	ip=$(ip -4 addr show phy0-sta0 2>/dev/null | awk '/inet /{print $2}')
+	ip=${ip%%/*}
+	if [ -z "$ip" ]; then
+		ip=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}')
+		ip=${ip%%/*}
+	fi
+	[ -n "$ip" ] && printf 'DATAHUB %s %s' "$ip" "$DATAHUB_KEY"
+	;;
+esac
diff --git a/package/luci-app-datahub/root/usr/bin/hub-init b/package/luci-app-datahub/root/usr/bin/hub-init
new file mode 100755
index 0000000000..1d8eb4bea5
