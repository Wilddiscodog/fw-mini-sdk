@@ -0,0 +1,87 @@
+'use strict';
+'require view';
+'require fs';
+'require ui';
+'require poll';
+
+var BIN = '/usr/bin/usbsw';
+
+function readVal(action) {
+	return fs.exec(BIN, [action]).then(function (r) {
+		return (r && r.stdout ? r.stdout.trim() : '?');
+	}).catch(function () { return '?'; });
+}
+
+return view.extend({
+	load: function () {
+		return Promise.all([ readVal('oe-get'), readVal('get') ]);
+	},
+
+	render: function (vals) {
+		var oeEl  = E('strong', {}, vals[0]);   // GPIO23 (OE)
+		var selEl = E('strong', {}, vals[1]);    // GPIO26 (SEL)
+
+		function refresh() {
+			return Promise.all([ readVal('oe-get'), readVal('get') ]).then(function (v) {
+				oeEl.textContent  = v[0];
+				selEl.textContent = v[1];
+			});
+		}
+
+		function run(action, label) {
+			return fs.exec(BIN, [action]).then(function () {
+				ui.addNotification(null, E('p', {}, (label || action)), 'info');
+				return refresh();
+			}).catch(function (e) {
+				ui.addNotification(null, E('p', {}, _('Failed: ') + e), 'danger');
+			});
+		}
+
+		poll.add(refresh, 5);
+
+		var btn = function (cls, txt, act, label) {
+			return E('button', { 'class': 'btn cbi-button ' + cls, 'click': function () { run(act, label); } }, txt);
+		};
+
+		return E('div', { 'class': 'cbi-map' }, [
+			E('h2', {}, _('USB Channel Switch (SGM7227)')),
+			E('div', { 'class': 'cbi-map-descr' }, _('GPIO23 = SGM7227 enable (OE), GPIO26 = channel select (host=router / pc=computer). Note: GPIO8 (5V power) is now driven automatically by the kernel USB regulator (always-on) and is no longer controlled here.')),
+
+			E('div', { 'class': 'cbi-section' }, [
+				E('h3', {}, _('Current state')),
+				E('p', {}, [ _('OE(gpio23)='), oeEl, '  ', _('SEL(gpio26)='), selEl ]),
+				E('div', { 'class': 'cbi-section-node' }, [
+					btn('cbi-button-action', _('USB ON (enable + host)'), 'usb-on', _('usb-on')),
+					' ',
+					btn('cbi-button-remove', _('USB OFF (disable)'), 'usb-off', _('usb-off'))
+				])
+			]),
+
+			E('div', { 'class': 'cbi-section' }, [
+				E('h3', {}, _('Enable — GPIO23 (SGM7227 OE)')),
+				E('div', { 'class': 'cbi-section-node' }, [
+					btn('cbi-button-action', _('Enable ON'),  'oe-on',  _('OE=1')),
+					' ',
+					btn('', _('Enable OFF'), 'oe-off', _('OE=0')),
+					' ',
+					btn('', _('Toggle'),     'oe-toggle', _('OE toggled'))
+				])
+			]),
+
+			E('div', { 'class': 'cbi-section' }, [
+				E('h3', {}, _('Channel — GPIO26 (SGM7227 SEL)')),
+				E('div', { 'class': 'cbi-section-node' }, [
+					btn('cbi-button-action', _('To device (host)'), 'host', _('SEL=host')),
+					' ',
+					btn('cbi-button-action', _('To PC (pass-through)'), 'pc', _('SEL=pc')),
+					' ',
+					btn('', _('Toggle'), 'toggle', _('SEL toggled'))
+				])
+			])
+		]);
+	},
+
+	handleSave: null,
+	handleSaveApply: null,
+	handleReset: null
+});
diff --git a/package/luci-app-usbswitch/root/etc/init.d/usbdefault b/package/luci-app-usbswitch/root/etc/init.d/usbdefault
