+++ b/package/luci-app-usbswitch/root/etc/init.d/usbdefault
@@ -0,0 +1,12 @@
+#!/bin/sh /etc/rc.common
+# 开机默认把 USB(存储)通道切给 AR9331 本机 (datahub 需要 U盘):
+#   GPIO23(OE)=1 使能 SGM7227 通路, GPIO26(SEL)=1 选到 host(AR9331) 侧。
+# START=11: 尽量赶在 USB 存储驱动扫描前把通道摆好。
+# 之后仍可用网页 luci-app-usbswitch 手动切到 pc(电脑) 排查/导数据。
+START=11
+
+start() {
+	/usr/bin/usbsw oe-on   # 使能通路 (GPIO23=1)
+	/usr/bin/usbsw host    # 切到本机通道 (GPIO26=1)
+	logger -t usbdefault "USB channel defaulted to HOST (SEL=1) on boot"
+}
