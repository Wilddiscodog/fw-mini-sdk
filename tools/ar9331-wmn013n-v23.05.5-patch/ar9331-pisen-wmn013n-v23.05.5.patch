@@ -0,0 +1,15 @@
+#!/bin/sh /etc/rc.common
+# wifi-guard — AP+STA 共存看门狗(防止 STA 连不上拖死管理AP)
+# 详见 /usr/bin/wifi-guard 头部注释
+
+START=99
+USE_PROCD=1
+
+start_service() {
+	procd_open_instance
+	procd_set_param command /usr/bin/wifi-guard
+	procd_set_param respawn 3600 5 0
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
diff --git a/files/etc/uci-defaults/99-default-wifi b/files/etc/uci-defaults/99-default-wifi
new file mode 100755
index 0000000000..4b017bd45a
--- /dev/null
+++ b/files/etc/uci-defaults/99-default-wifi
@@ -0,0 +1,81 @@
+#!/bin/sh
+# datahub 开机网络默认配置 (首次启动执行一次):
+#   1. 常驻管理AP "Hub-xxxx" (psk: hyundai415), 手机连上后 http://192.168.66.1 配网
+#   2. 配网后 STA(wwan) 上家庭主路由, 管理AP 仍保留作救援入口 (AP+STA 并存)
+#   3. umdns 让设备可被 hub-xxxx.local 解析; 时区/ntp 保证消息时间戳正确
+#   4. 防火墙: 家庭网段(192.168.0.0/16)可访问 22/80/445 + mDNS
+
+# 无线配置可能尚未生成
+[ -e /etc/config/wireless ] || /sbin/wifi config
+
+# 设备后缀: 取 wifi MAC 末4位 hex (5台设备各自唯一, 如 Hub-2b20)
+mac=$(cat /sys/class/ieee80211/phy0/macaddress 2>/dev/null | tr -d : | tail -c 5)
+[ -n "$mac" ] || mac=$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d : | tail -c 5)
+[ -n "$mac" ] || mac=0000
+HOSTNAME="Hub-$mac"
+
+# ---- 系统主机名 / 时区 / NTP ----
+uci -q batch <<-EOF
+	set system.@system[0].hostname='$HOSTNAME'
+	set system.@system[0].timezone='CST-8'
+	set system.@system[0].zonename='Asia/Shanghai'
+	set system.@system[0].log_size='64'
+	commit system
+	set system.ntp='timeserver'
+	add_list system.ntp.server='ntp.aliyun.com'
+	add_list system.ntp.server='ntp1.aliyun.com'
+	set system.ntp.enable_server='0'
+	commit system
+EOF
+hostname "$HOSTNAME"
+
+# ---- 管理网段 192.168.66.1/24 ----
+uci set network.lan.ipaddr='192.168.66.1'
+uci set network.lan.netmask='255.255.255.0'
+# 预建 wwan (STA 上家庭网用, LuCI 配网 Join Network 时直接选中)
+uci -q get network.wwan >/dev/null || {
+	uci set network.wwan=interface
+	uci set network.wwan.proto='dhcp'
+}
+uci commit network
+
+# ---- 无线: radio0 = 常驻管理AP + (配网后追加) STA ----
+uci -q batch <<-EOF
+	set wireless.radio0.disabled='0'
+	set wireless.radio0.country='CN'
+	set wireless.radio0.channel='auto'
+	delete wireless.default_radio0
+	set wireless.ap_mgmt=wifi-iface
+	set wireless.ap_mgmt.device='radio0'
+	set wireless.ap_mgmt.mode='ap'
+	set wireless.ap_mgmt.ssid='$HOSTNAME'
+	set wireless.ap_mgmt.encryption='psk2'
+	set wireless.ap_mgmt.key='hyundai415'
+	set wireless.ap_mgmt.network='lan'
+	set wireless.ap_mgmt.hidden='0'
+	commit wireless
+EOF
+
+# ---- 防火墙: wwan 归 wan 区; 家庭网段可达 22/80/445; 放行 mDNS ----
+# 找到 wan zone (按 name), 追加 wwan
+wan_zone=$(uci -q show firewall | grep '=zone' | grep '\.name=.wan.' | cut -d. -f2 | head -1)
+[ -n "$wan_zone" ] && uci add_list firewall.$wan_zone.network='wwan'
+
+uci -q batch <<-EOF
+	set firewall.hub_mgmt=rule
+	set firewall.hub_mgmt.name='Allow-hub-mgmt-from-home'
+	set firewall.hub_mgmt.src='wan'
+	set firewall.hub_mgmt.src_ip='192.168.0.0/16'
+	set firewall.hub_mgmt.proto='tcp'
+	set firewall.hub_mgmt.dest_port='22 80 445'
+	set firewall.hub_mgmt.target='ACCEPT'
+	set firewall.hub_mdns=rule
+	set firewall.hub_mdns.name='Allow-mDNS'
+	set firewall.hub_mdns.src='wan'
+	set firewall.hub_mdns.proto='udp'
+	set firewall.hub_mdns.dest_port='5353'
+	set firewall.hub_mdns.target='ACCEPT'
+	commit firewall
+EOF
+
+exit 0
diff --git a/files/usr/bin/wifi-guard b/files/usr/bin/wifi-guard
new file mode 100755
index 0000000000..53248d0ab5
--- /dev/null
+++ b/files/usr/bin/wifi-guard
@@ -0,0 +1,64 @@
+#!/bin/sh
+# wifi-guard — AP+STA 同射频共存看门狗
+#
+# 背景: OpenWrt mac80211 的已知行为 —— 同一 radio 上 AP+STA 并存时,
+#       STA 关联不成功(如换了环境搜不到原 SSID),hostapd 会一直等 STA
+#       锁信道,AP 也不发 beacon → 管理AP"消失", 无法配网。
+#
+# 策略: STA 启用后连续 ${GUARD_TIMEOUT} 秒未关联(含一直搜不到保存的
+#       SSID / 密码错 / 信号差) → 删除该 STA 段(保存的 SSID/密码一并清除)
+#       并 wifi reload, AP 立即恢复发信号; 手机连 Hub-xxxx 在 LuCI 无线页
+#       重新扫描 Join 即完成重新配网。
+#       选"删除"而非"禁用": 禁用会残留 disabled 的 STA 段, 之后 Join 新
+#       网络又建一段, 残段既碍人工判断, 也会让本脚本的挑段逻辑选错对象。
+#
+# 注意: 家里主路由重启一般 1~2 分钟内恢复, 180s 超时不会误删;
+#       若担心更长的断网窗口, 调大 GUARD_TIMEOUT 即可。
+
+GUARD_TIMEOUT=180   # 秒
+MARK=/tmp/.wifi_guard_ts
+LOG_TAG=wifi-guard
+
+sta_section() {  # 输出第一个处于启用状态的 sta 段名(如 wifinet1), 无则空
+	local s
+	for s in $(uci -q show wireless 2>/dev/null | grep "mode='sta'" | cut -d. -f2 | cut -d= -f1); do
+		[ "$(uci -q get wireless.$s.disabled)" = "1" ] || { echo "$s"; return; }
+	done
+}
+
+sta_associated() {  # 0=已关联 1=未关联/无vif
+	local vif
+	vif=$(iwinfo 2>/dev/null | awk '/phy0-sta/{print $1; exit}')
+	[ -n "$vif" ] || return 1
+	iwinfo "$vif" info 2>/dev/null | grep -q "Not-Associated" && return 1
+	return 0
+}
+
+logger -s -t $LOG_TAG "watchdog started (timeout=${GUARD_TIMEOUT}s)"
+rm -f "$MARK"
+
+while :; do
+	sleep 20
+	sec=$(sta_section)
+
+	# 无启用的 sta 段: 纯AP模式, 空转
+	[ -n "$sec" ] || { rm -f "$MARK"; continue; }
+
+	if sta_associated; then
+		rm -f "$MARK"
+		continue
+	fi
+
+	# 未关联: 开始/继续计时
+	now=$(date +%s)
+	[ -f "$MARK" ] || echo "$now" > "$MARK"
+	first=$(cat "$MARK" 2>/dev/null || echo "$now")
+
+	if [ $((now - first)) -ge "$GUARD_TIMEOUT" ]; then
+		logger -s -t $LOG_TAG "STA '$sec' ${GUARD_TIMEOUT}s 未关联, 清除其配置并恢复管理AP"
+		uci delete "wireless.$sec"
+		uci commit wireless
+		wifi reload
+		rm -f "$MARK"
+	fi
+done
diff --git a/package/luci-app-datahub/Makefile b/package/luci-app-datahub/Makefile
