+++ b/package/luci-app-datahub/root/usr/bin/hub-maint
@@ -0,0 +1,49 @@
+#!/bin/sh
+# hub-maint — datahub 每日维护 (cron 04:00 调用, 也可手动跑)
+#   1. 按保留期清理过期记录+附件  2. 快照备份 datahub.db.bak  3. PRAGMA optimize
+
+MOUNT=$(uci -q get datahub.hub.mount || echo /mnt/sda1)
+ROOT="$MOUNT/hub"
+DB="$ROOT/db/datahub.db"
+BAK="$ROOT/db/datahub.db.bak"
+RETAIN=$(uci -q get datahub.hub.retain || echo 180)
+
+grep -q " $MOUNT " /proc/mounts || { echo "U盘未挂载, 跳过"; exit 1; }
+[ -f "$DB" ] || { echo "数据库不存在"; exit 1; }
+case "$RETAIN" in ''|*[!0-9]*) RETAIN=180;; esac
+
+NOW=$(date +%s)
+
+# 1. 过期附件文件 (先取路径再删行)
+cutoff=$(sqlite3 -batch "$DB" "SELECT CAST(strftime('%s','now','-$RETAIN days') AS INTEGER);")
+[ -n "$cutoff" ] || { echo "计算cutoff失败"; exit 1; }
+
+sqlite3 -batch "$DB" "SELECT path FROM records WHERE ts<$cutoff AND path IS NOT NULL;" | \
+while read -r p; do
+	case "$p" in
+		data/*) rm -f "$ROOT/$p" ;;
+	esac
+done
+
+sqlite3 -batch "$DB" "PRAGMA busy_timeout=3000;
+	DELETE FROM records WHERE ts<$cutoff;
+	DELETE FROM acks   WHERE ts<$cutoff;
+	PRAGMA optimize;"
+
+# 清掉空日期目录
+find "$ROOT/data" -mindepth 4 -type d -empty -exec rmdir {} \; 2>/dev/null
+
+# 2. 在线一致性快照 (备份/导出的规范工件)
+sqlite3 "$DB" ".backup $BAK" || { echo "备份失败"; exit 1; }
+
+# 3. 清理超过一天的 CGI 中转残留
+find "$ROOT/tmp" -type f -mtime +1 -delete 2>/dev/null || \
+	find "$ROOT/tmp" -type f -mtime +1 -exec rm -f {} \; 2>/dev/null
+
+# 4. 音乐库扫描(SMB 拖拷进 music/ 的歌曲登记入库)
+[ -x /usr/bin/hub-scan-music ] && /usr/bin/hub-scan-music >/dev/null 2>&1
+
+n=$(sqlite3 -batch "$DB" "SELECT count(*) FROM records;")
+b=$(wc -c < "$BAK")
+logger -t datahub "maint: retain=${RETAIN}d cutoff=$cutoff records=$n bak=${b}B"
+echo "OK records=$n bak=${b}B"
diff --git a/package/luci-app-datahub/root/usr/bin/hub-scan-music b/package/luci-app-datahub/root/usr/bin/hub-scan-music
new file mode 100755
index 0000000000..659a016557
--- /dev/null
+++ b/package/luci-app-datahub/root/usr/bin/hub-scan-music
@@ -0,0 +1,47 @@
+#!/bin/sh
+# hub-scan-music — 音乐库扫描入库
+#
+# 用途: 歌曲经 SMB(\\IP\hub\music\)拖拷进 U盘后, 本脚本把它们登记进
+#       records(channel=music), 局域网播放器即可 list/get 点播。
+#       也可对单个目录手动调用: hub-scan-music
+#
+# 约定: 目录 $ROOT/music/ 下任意子目录; 支持扩展名见 EXT
+#       记录 dev='library', uid='m-<md5(路径)>'(幂等), txt=文件名(去扩展名,即歌名)
+#       库里 path 指向的文件被删时, 对应记录同步删除
+
+MOUNT=$(uci -q get datahub.hub.mount || echo /mnt/sda1)
+ROOT="$MOUNT/hub"
+DB="$ROOT/db/datahub.db"
+MUSIC="$ROOT/music"
+EXT="mp3 wav flac m4a aac ogg opus amr ape wma"
+
+es() { printf "%s" "$1" | sed "s/'/''/g"; }  # SQL 字符串转义
+
+grep -q " $MOUNT " /proc/mounts || exit 1
+[ -f "$DB" ] || exit 1
+mkdir -p "$MUSIC"
+
+# 1. 入库: 目录里的每个音频文件
+find "$MUSIC" -type f | while read -r f; do
+	ext="${f##*.}"
+	case " $EXT " in *" $ext "*) ;; *) continue;; esac
+	rel="${f#$ROOT/}"
+	[ "${#rel}" -gt 2 ] || continue
+	uid="m-$(printf '%s' "$rel" | md5sum | cut -c1-12)"
+	title=$(basename "$f"); title="${title%.*}"
+	size=$(wc -c < "$f")
+	# 已在库中(按uid)则跳过
+	ex=$(sqlite3 -batch "$DB" "SELECT id FROM records WHERE uid='$uid';")
+	[ -n "$ex" ] && continue
+	sqlite3 -batch "$DB" "INSERT INTO records(uid,devid,channel,ts,dtype,txt,path,bytes,fmt,rate,dur_ms)
+		VALUES('$uid','library','music',$(date +%s),'file','$(es "$title")','$rel',$size,'$ext',0,0);"
+done
+
+# 2. 清理: 库内 music 记录指向的文件已不存在 → 删除记录
+sqlite3 -batch "$DB" "SELECT id,path FROM records WHERE channel='music' AND devid='library';" | \
+while IFS='|' read -r id path; do
+	[ -f "$ROOT/$path" ] || sqlite3 -batch "$DB" "DELETE FROM records WHERE id=$id;"
+done
+
+n=$(sqlite3 -batch "$DB" "SELECT count(*) FROM records WHERE channel='music';")
+echo "music library: $n tracks"
diff --git a/package/luci-app-datahub/root/usr/share/datahub/schema.sql b/package/luci-app-datahub/root/usr/share/datahub/schema.sql
new file mode 100644
index 0000000000..ce41728e6d
--- /dev/null
+++ b/package/luci-app-datahub/root/usr/share/datahub/schema.sql
@@ -0,0 +1,46 @@
+-- datahub schema — 通用家庭设备数据中枢
+-- 执行: sqlite3 datahub.db < /usr/share/datahub/schema.sql  (幂等, 可重复执行)
+
+PRAGMA journal_mode=DELETE;
+PRAGMA synchronous=FULL;
+PRAGMA busy_timeout=3000;
+
+CREATE TABLE IF NOT EXISTS devices (
+  devid      TEXT PRIMARY KEY,        -- 设备唯一ID (自定义, 如 esp32s3-a1)
+  name       TEXT DEFAULT '',         -- 显示名 ("客厅对讲机")
+  kind       TEXT DEFAULT 'generic',  -- intercom / sensor / generic ...
+  apikey     TEXT DEFAULT '',         -- 预留: 按设备独立密钥
+  created_at INTEGER,
+  last_seen  INTEGER
+);
+
+-- 唯一数据表: 一切设备共用 (channel 区分业务)
+CREATE TABLE IF NOT EXISTS records (
+  id         INTEGER PRIMARY KEY AUTOINCREMENT,
+  uid        TEXT UNIQUE,             -- 客户端幂等ID (断网重发不重复)
+  devid      TEXT NOT NULL,
+  channel    TEXT NOT NULL,           -- audio / telemetry / events / 自定义
+  ts         INTEGER NOT NULL,        -- 服务器时间(epoch秒, 权威)
+  client_ts  INTEGER,                 -- 客户端采集时刻(留痕)
+  dtype      TEXT DEFAULT 'row',      -- row=结构化 / file=附件
+  val        REAL,                    -- row: 数值 (温度/电压/...)
+  txt        TEXT,                    -- row: 短文本 (事件描述)
+  data       TEXT,                    -- row: JSON 负载 (任意扩展)
+  path       TEXT,                    -- file: 相对 hub/ 根的路径
+  bytes      INTEGER,                 -- file: 字节数
+  fmt        TEXT,                    -- file: alaw/ulaw/pcm/...
+  dur_ms     INTEGER,                 -- file: 时长(毫秒)
+  rate       INTEGER,                 -- file: 采样率 (WAV头合成用)
+  state      INTEGER DEFAULT 0
+);
+
+CREATE INDEX IF NOT EXISTS idx_rec_dev_ch_ts ON records(devid, channel, ts);
+CREATE INDEX IF NOT EXISTS idx_rec_ts       ON records(ts);
+
+-- 已取走/已读: 哪台设备取走了哪条
+CREATE TABLE IF NOT EXISTS acks (
+  rec_id INTEGER NOT NULL,
+  devid  TEXT NOT NULL,
+  ts     INTEGER NOT NULL,
+  PRIMARY KEY (rec_id, devid)
+);
