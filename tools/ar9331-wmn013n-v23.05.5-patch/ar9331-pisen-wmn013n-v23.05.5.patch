diff --git a/package/luci-app-datahub/root/www/cgi-bin/hub b/package/luci-app-datahub/root/www/cgi-bin/hub
new file mode 100755
index 0000000000..96507a6821
--- /dev/null
+++ b/package/luci-app-datahub/root/www/cgi-bin/hub
@@ -0,0 +1,332 @@
+#!/bin/sh
+# hub — datahub CGI API (uhttpd: /cgi-bin/hub)
+#
+# 通用家庭设备数据中枢:
+#   put    POST 上传: dtype=row 结构化 / dtype=file 附件(body=裸流)
+#   list   GET  增量拉取记录 (id 游标, 可选 unread 过滤)
+#   get    GET  取单条: row→JSON / file→音频流(自动包WAV头, &raw=1拿裸流)
+#   ack    GET  标记某设备已取走(已读)
+#   reg    POST 注册/更新设备信息(name/kind)
+#   stats  GET  总览统计(免key, 给LuCI/调试)
+#   export GET  打包导出(.db快照+近期附件, gzip tar, 免key)
+#
+# 鉴权: 除 stats/export 外需 key=uci(datahub.hub.key)
+# 写操作经唯一uid幂等; 并发由SQLite busy_timeout串行化; 附件先写tmp再mv。
+
+HUB_MOUNT=$(uci -q get datahub.hub.mount || echo /mnt/sda1)
+ROOT="$HUB_MOUNT/hub"
+DB="$ROOT/db/datahub.db"
+BAK="$ROOT/db/datahub.db.bak"
+KEY=$(uci -q get datahub.hub.key)
+CL=${CONTENT_LENGTH:-0}
+NOW=$(date +%s)
+
+# ---------- 小工具 ----------
+
+urldec() {  # %XX / '+' → 原始字节 (纯shell, 与busybox ash/bash/gawk行为一致)
+	local s="$1" out="" c hh n rest
+	while [ -n "$s" ]; do
+		c=${s%${s#?}}
+		case "$c" in
+			"%")
+				if [ ${#s} -ge 3 ]; then
+					rest=${s#%}; hh=${rest%"${rest#??}"}; rest=${rest#??}
+					case "$hh" in
+						*[!0-9A-Fa-f]*)
+							out="$out$c" ;;
+						*)
+							n=$((0x$hh))
+							# 0/NUL/换行无法安全穿过命令替换, 跳过
+							[ "$n" -gt 0 ] && [ "$n" -ne 10 ] && \
+								out="$out$(printf "\\$(printf '%03o' "$n")")" ;;
+					esac
+					s=$rest
+				else
+					out="$out$c"; s=${s#?}
+				fi ;;
+			"+")
+				out="$out "; s=${s#?} ;;
+			*)
+				out="$out$c"; s=${s#?} ;;
+		esac
+	done
+	printf '%s' "$out"
+}
+
+ok_id() {  # 标识符: [A-Za-z0-9_.-] 长度1..48
+	case "$1" in ''|*[!A-Za-z0-9_.-]*) return 1;; esac
+	[ ${#1} -le 48 ] || return 1
+	return 0
+}
+ok_num() {  # 非负整数
+	case "$1" in ''|*[!0-9]*) return 1;; esac
+	return 0
+}
+es() { printf "%s" "$1" | sed "s/'/''/g"; }  # SQL 字符串转义
+
+sq()  { sqlite3 -batch "$DB" "$1"; }
+sqj() {  # 查询→JSON数组(空结果补 [])
+	o=$(sqlite3 -batch -json "$DB" "$1")
+	[ -n "$o" ] || o='[]'
+	printf "%s" "$o"
+}
+
+jerr() { printf 'Status: %s\r\nContent-Type: application/json\r\n\r\n{"ok":0,"err":"%s"}\n' "$1" "$2"; exit 0; }
+jok()  { printf 'Status: 200 OK\r\nContent-Type: application/json\r\n\r\n{"ok":1%s}\n' "$1"; exit 0; }
+
+mounted() { grep -q " $HUB_MOUNT " /proc/mounts; }
+
+# ---------- 解析 QUERY_STRING ----------
+
+cmd= key= dev= ch= uid= dtype= val= txt= name= kind= fmt= dur= rate= client_ts=
+since= limit= id= ackdev= days=7 raw=0 unread=0 from=
+
+OIFS=$IFS; IFS='&'
+for p in $QUERY_STRING; do
+	k=${p%%=*}; v=${p#*=}
+	case "$k" in
+		cmd)       cmd=$(urldec "$v");;
+		key)       key=$v;;
+		dev)       dev=$(urldec "$v");;
+		ch)        ch=$(urldec "$v");;
+		uid)       uid=$(urldec "$v");;
+		dtype)     dtype=$(urldec "$v");;
+		val)       val=$(urldec "$v");;
+		txt)       txt=$(urldec "$v");;
+		name)      name=$(urldec "$v");;
+		kind)      kind=$(urldec "$v");;
+		fmt)       fmt=$(urldec "$v");;
+		dur)       dur=$v;;
+		rate)      rate=$v;;
+		client_ts) client_ts=$v;;
+		from)      from=$(urldec "$v");;
+		since)     since=$v;;
+		limit)     limit=$v;;
+		id)        id=$v;;
+		ackdev)    ackdev=$(urldec "$v");;
+		days)      days=$v;;
+		raw)       raw=1;;
+		unread)    unread=1;;
+	esac
+done
+IFS=$OIFS
+
+case "$cmd" in
+	put|list|get|ack|reg|stats|export) ;;
+	*) jerr 400 "bad cmd";;
+esac
+
+# 免key的只读/导出命令; 其余验key
+case "$cmd" in
+	stats|export) ;;
+	*) [ -n "$KEY" ] && [ "$key" = "$KEY" ] || jerr 403 "bad key";;
+esac
+
+mounted || jerr 503 "usb storage not mounted"
+[ -f "$DB" ] || jerr 503 "db not initialized (run hub-init)"
+
+# ---------- 命令实现 ----------
+
+cts_sql() {  # client_ts → 合法整数或 NULL
+	ok_num "$client_ts" && printf "%s" "$client_ts" || echo NULL
+}
+
+upsert_dev() {  # $1=devid $2=name $3=kind (name 仅在非空时更新)
+	local n k extra
+	n=$(es "$2"); k=$(es "$3"); extra=""
+	[ -n "$2" ] && extra=",name='$n'"
+	sq "INSERT INTO devices(devid,name,kind,apikey,created_at,last_seen)
+	    VALUES('$1','$n','$k','',$NOW,$NOW)
+	    ON CONFLICT(devid) DO UPDATE SET last_seen=$NOW$extra;"
+}
+
+do_put() {
+	ok_id "$dev" || jerr 400 "bad dev"
+	ok_id "$ch"  || jerr 400 "bad ch"
+	[ -n "$dtype" ] || dtype=row
+	case "$dtype" in row|file) ;; *) jerr 400 "bad dtype";; esac
+	upsert_dev "$dev" "$name" "$kind"
+
+	# 幂等: uid 已存在直接返回旧id
+	if [ -n "$uid" ]; then
+		ok_id "$uid" || jerr 400 "bad uid"
+		e=$(sq "SELECT id FROM records WHERE uid='$(es "$uid")';")
+		[ -n "$e" ] && jok ",\"id\":$e,\"dup\":1"
+	fi
+
+	if [ "$dtype" = "file" ]; then
+		ok_num "$CL" && [ "$CL" -gt 0 ] || jerr 400 "empty body"
+		[ "$CL" -le 52428800 ] || jerr 413 "too large"
+		[ -z "$dur" ] || { ok_num "$dur" || jerr 400 "bad dur"; }
+		[ -z "$rate" ] || { ok_num "$rate" || jerr 400 "bad rate"; }
+		[ -n "$fmt" ] || fmt=bin
+		ok_id "$fmt" || jerr 400 "bad fmt"
+
+		tmp="$ROOT/tmp/up.$$"
+		mkdir -p "$ROOT/tmp"
+		head -c "$CL" > "$tmp" || { rm -f "$tmp"; jerr 500 "read body failed"; }
+		# BusyBox wc -c 可能带前导空格, 必须 trim 再比
+		got=$(wc -c < "$tmp" | tr -d ' \t\r\n')
+		[ "$got" = "$CL" ] || { rm -f "$tmp"; jerr 400 "short body"; }
+
+		day=$(date +%Y%m%d); stamp=$(date +%H%M%S)
+		if [ -n "$uid" ]; then base="$stamp-$uid"; else base="$stamp-$$"; fi
+		dir="$ROOT/data/$dev/$ch/$day"
+		mkdir -p "$dir" || { rm -f "$tmp"; jerr 500 "mkdir failed"; }
+		rel="data/$dev/$ch/$day/$base.bin"
+		mv "$tmp" "$ROOT/$rel" || jerr 500 "store failed"
+		size=$(wc -c < "$ROOT/$rel")
+
+		id=$(sq "INSERT INTO records(uid,devid,channel,ts,client_ts,dtype,txt,path,bytes,fmt,dur_ms,rate)
+		    VALUES($( [ -n "$uid" ] && printf "'%s'" "$(es "$uid")" || echo NULL),'$dev','$ch',$NOW,
+		    $(cts_sql),'file','$(es "$txt")','$rel',$size,'$fmt',${dur:-0},${rate:-0});
+		    SELECT last_insert_rowid();")
+		jok ",\"id\":$id,\"bytes\":$size,\"path\":\"$rel\""
+	else
+		# 行数据: val(数字)/txt(短文本) 走query; JSON负载走body(<=64KB存data列)
+		vdat=""
+		if ok_num "$CL" && [ "$CL" -gt 0 ] && [ "$CL" -le 65536 ]; then
+			vdat=$(head -c "$CL" | sed "s/'/''/g")
+		fi
+		v=NULL
+		printf "%s" "$val" | grep -qE '^-?[0-9]+(\.[0-9]+)?$' && v="$val"
+		id=$(sq "INSERT INTO records(uid,devid,channel,ts,client_ts,dtype,val,txt,data)
+		    VALUES($( [ -n "$uid" ] && printf "'%s'" "$(es "$uid")" || echo NULL),'$dev','$ch',$NOW,
+		    $(cts_sql),'row',$v,'$(es "$txt")','$vdat');
+		    SELECT last_insert_rowid();")
+		jok ",\"id\":$id"
+	fi
+}
+
+do_list() {
+	ok_num "$since" || since=0
+	ok_num "$limit" || limit=20
+	[ "$limit" -ge 1 ] && [ "$limit" -le 200 ] || limit=20
+	w="id>$since"
+	# from = 发送者过滤; dev = "我的视角"(unread 过滤掉本机已 ack 的)
+	[ -n "$from" ] && { ok_id "$from" || jerr 400 "bad from"; w="$w AND devid='$from'"; }
+	[ -n "$ch" ]  && { ok_id "$ch"  || jerr 400 "bad ch";  w="$w AND channel='$ch'"; }
+	[ "$unread" = 1 ] && [ -n "$dev" ] && \
+		w="$w AND NOT EXISTS(SELECT 1 FROM acks a WHERE a.rec_id=records.id AND a.devid='$dev')"
+	rows=$(sqj "SELECT id,devid,channel,ts,dtype,val,txt,data,fmt,dur_ms,bytes FROM records WHERE $w ORDER BY id DESC LIMIT $limit;")
+	printf 'Status: 200 OK\r\nContent-Type: application/json\r\n\r\n{"ok":1,"rows":%s}\n' "$rows"
+}
+
+le16() { local n=$1 i=0 b; while [ $i -lt 2 ]; do b=$((n%256)); printf '\\%03o' $b; n=$((n/256)); i=$((i+1)); done; }
+le32() { local n=$1 i=0 b; while [ $i -lt 4 ]; do b=$((n%256)); printf '\\%03o' $b; n=$((n/256)); i=$((i+1)); done; }
+
+wav_hdr() {  # $1=数据字节 $2=采样率 $3=tag(1=pcm16 6=alaw 7=ulak) → 44字节头(八进制转义格式串)
+	local len=$1 rate=$2 tag=$3 bits bra
+	case "$tag" in
+		1) bits=16; bra=$((rate*2));;
+		*) bits=8;  bra=$rate;;
+	esac
+	# RIFF|len|WAVE|fmt |16|tag|ch=1|rate|byterate|align|bits|data|len
+	printf 'RIFF%sWAVEfmt %s%s%s%s%s%s%sdata%s' \
+		"$(le32 $((36+len)))" '\020\000\000\000' \
+		"$(le16 $tag)" '\001\000' "$(le32 $rate)" "$(le32 $bra)" \
+		"$(le16 $((bits/8)))" "$(le16 $bits)" "$(le32 $len)"
+}
+
+do_get() {
+	ok_num "$id" || jerr 400 "bad id"
+	row=$(sq "SELECT dtype,path,fmt,bytes,rate FROM records WHERE id=$id;")
+	[ -n "$row" ] || jerr 404 "no such record"
+	dtyp=${row%%|*}; rest=${row#*|}
+	path=${rest%%|*}; rest=${rest#*|}
+	fmt=${rest%%|*}; rest=${rest#*|}
+	bytes=${rest%%|*}; rate=${rest#*|}
+
+	if [ "$dtyp" != "file" ]; then
+		o=$(sqlite3 -batch -json "$DB" "SELECT id,devid,channel,ts,client_ts,dtype,val,txt,data FROM records WHERE id=$id;")
+		[ -n "$o" ] || o='[]'
+		printf 'Status: 200 OK\r\nContent-Type: application/json\r\n\r\n{"ok":1,"row":%s}\n' "$o"
+		return
+	fi
+
+	f="$ROOT/$path"
+	[ -f "$f" ] || jerr 404 "file missing"
+	[ -n "$rate" ] || rate=8000
+
+	tag=0
+	[ "$raw" != 1 ] && case "$fmt" in
+		alaw) tag=6;;
+		ulaw) tag=7;;
+		pcm)  tag=1;;
+	esac
+
+	if [ "$tag" != 0 ]; then
+		hdr=$(wav_hdr "$bytes" "$rate" "$tag")
+		printf 'Status: 200 OK\r\nContent-Type: audio/wav\r\nContent-Length: %s\r\nContent-Disposition: inline; filename="%s.wav"\r\n\r\n' \
+			"$((bytes+44))" "$id"
+		printf "$hdr"
+	else
+		# 按扩展名给 Content-Type: 浏览器<audio>/手机播放器可直接流播
+		ct="application/octet-stream"
+		case "$fmt" in
+			mp3)  ct="audio/mpeg";;
+			m4a)  ct="audio/mp4";;
+			aac)  ct="audio/aac";;
+			flac) ct="audio/flac";;
+			ogg)  ct="audio/ogg";;
+			opus) ct="audio/ogg";;
+			wav)  ct="audio/wav";;
+			amr)  ct="audio/amr";;
+			ape)  ct="audio/x-ape";;
+			wma)  ct="audio/x-ms-wma";;
+		esac
+		# 磁盘上可能是 .bin, 下载名用真实 fmt 扩展名
+		ext=$fmt; [ -n "$ext" ] || ext=bin
+		printf 'Status: 200 OK\r\nContent-Type: %s\r\nContent-Length: %s\r\nContent-Disposition: attachment; filename="%s.%s"\r\n\r\n' \
+			"$ct" "$bytes" "$id" "$ext"
+	fi
+	cat "$f"
+}
+
+do_ack() {
+	ok_num "$id" || jerr 400 "bad id"
+	ok_id "$ackdev" || jerr 400 "bad dev"
+	sq "INSERT OR REPLACE INTO acks(rec_id,devid,ts) VALUES($id,'$ackdev',$NOW);"
+	jok ""
+}
+
+do_reg() {
+	ok_id "$dev" || jerr 400 "bad dev"
+	[ ${#name} -le 64 ] || jerr 400 "name too long"
+	if [ -n "$kind" ]; then ok_id "$kind" || jerr 400 "bad kind"; else kind=generic; fi
+	sq "INSERT INTO devices(devid,name,kind,apikey,created_at,last_seen)
+	    VALUES('$(es "$dev")','$(es "$name")','$kind','',$NOW,$NOW)
+	    ON CONFLICT(devid) DO UPDATE SET name=excluded.name,kind=excluded.kind,last_seen=$NOW;"
+	jok ""
+}
+
+do_stats() {
+	db_b=$(wc -c < "$DB" 2>/dev/null || echo 0)
+	bak_b=0; bak_ts=0
+	if [ -f "$BAK" ]; then bak_b=$(wc -c < "$BAK"); bak_ts=$(date -r "$BAK" +%s); fi
+	dsk=$(df -k "$HUB_MOUNT" 2>/dev/null | tail -1 | awk '{print $2" "$4}')
+	d_tot=${dsk%% *}; d_free=${dsk#* }
+	total=$(sq "SELECT count(*) FROM records;")
+	today=$(sq "SELECT count(*) FROM records WHERE ts>strftime('%s','now','-1 day');")
+	devs=$(sqj "SELECT d.devid AS devid,d.name AS name,d.kind AS kind,d.last_seen AS last_seen,
+	    count(r.id) AS records FROM devices d LEFT JOIN records r ON r.devid=d.devid
+	    GROUP BY d.devid ORDER BY d.last_seen DESC;")
+	chs=$(sqj "SELECT channel,count(*) AS records FROM records GROUP BY channel ORDER BY records DESC;")
+	rec=$(sqj "SELECT id,devid,channel,ts,dtype,val,txt,fmt,dur_ms,bytes FROM records ORDER BY id DESC LIMIT 20;")
+	printf 'Status: 200 OK\r\nContent-Type: application/json\r\n\r\n{"ok":1,"now":%s,"key":"%s","disk":{"total":%s,"free":%s},"db_bytes":%s,"bak_bytes":%s,"bak_ts":%s,"records":%s,"today":%s,"devices":%s,"channels":%s,"recent":%s}\n' \
+		"$NOW" "$KEY" "${d_tot:-0}" "${d_free:-0}" "$db_b" "$bak_b" "$bak_ts" "$total" "$today" "$devs" "$chs" "$rec"
+}
+
+do_export() {
+	ok_num "$days" || days=7
+	[ "$days" -ge 1 ] && [ "$days" -le 90 ] || days=7
+	mkdir -p "$ROOT/db"
+	sqlite3 "$DB" ".backup $BAK" || jerr 500 "backup failed"
+	files=$(cd "$ROOT" && find data -type f -mtime -"$days" 2>/dev/null)
+	nm="datahub-$(date +%Y%m%d).tar.gz"
+	printf 'Status: 200 OK\r\nContent-Type: application/gzip\r\nContent-Disposition: attachment; filename="%s"\r\n\r\n' "$nm"
+	tar cf - -C "$ROOT" db/datahub.db.bak $files | gzip
+}
+
+case "$cmd" in
+	put)    do_put;;
+	list)   do_list;;
+	get)    do_get;;
+	ack)    do_ack;;
+	reg)    do_reg;;
+	stats)  do_stats;;
+	export) do_export;;
+esac
diff --git a/package/luci-app-datahub/root/www/music.html b/package/luci-app-datahub/root/www/music.html
new file mode 100644
index 0000000000..64b8e00d0f
--- /dev/null
+++ b/package/luci-app-datahub/root/www/music.html
@@ -0,0 +1,150 @@
+<!DOCTYPE html>
+<html lang="zh">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Hub 点歌台</title>
+<style>
+	body { font-family: -apple-system, sans-serif; background: #111; color: #eee;
+	       max-width: 640px; margin: 0 auto; padding: 12px; }
+	h1 { font-size: 1.15em; color: #6cf; }
+	#player { position: sticky; top: 0; background: #111; padding: 8px 0; z-index: 9; }
+	audio { width: 100%; }
+	#now { font-size: .9em; color: #9f9; margin: 4px 0; min-height: 1.2em; }
+	ol { list-style: none; padding: 0; }
+	li { display: flex; align-items: center; gap: 8px; padding: 10px 8px;
+	     border-bottom: 1px solid #222; cursor: pointer; }
+	li.active { background: #1c2b3a; }
+	li .t { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+	li .s { color: #888; font-size: .8em; }
+	.num { color: #678; font-size: .85em; width: 1.6em; text-align: right; }
+	#msg { color: #f96; padding: 20px; text-align: center; }
+	button { background: none; border: none; color: #6cf; font-size: 1em; }
+</style>
+</head>
+<body>
+<h1>🎵 Hub 点歌台 <span id="cnt" style="color:#888;font-size:.75em"></span></h1>
+<div id="upbar" style="display:flex;gap:8px;align-items:center;padding:6px 0">
+	<label class="btn" style="background:#1c3a5c;border-radius:6px;padding:8px 14px;cursor:pointer">
+		⬆ 上传歌曲<input id="fi" type="file" accept=".mp3,.wav,.flac,.m4a,.aac,.ogg,.opus,.amr,.ape,.wma" multiple style="display:none">
+	</label>
+	<span id="upinfo" style="color:#888;font-size:.85em">也可以把文件直接拖进本页面</span>
+</div>
+<div id="player">
+	<audio id="au" controls preload="none"></audio>
+	<div id="now"></div>
+</div>
+<div id="msg">加载中…</div>
+<ol id="list"></ol>
+
+<script>
+'use strict';
+var API = '/cgi-bin/hub', key = '', rows = [], cur = -1;
+
+function fmtSize(n) {
+	if (n >= 1048576) return (n / 1048576).toFixed(1) + 'M';
+	if (n >= 1024) return (n / 1024).toFixed(0) + 'K';
+	return n + 'B';
+}
+
+function play(i) {
+	var au = document.getElementById('au');
+	cur = i;
+	au.src = API + '?cmd=get&key=' + encodeURIComponent(key) + '&id=' + rows[i].id;
+	au.play();
+	document.getElementById('now').textContent = '▶ ' + (rows[i].txt || rows[i].id) + ' — ' + fmtSize(rows[i].bytes);
+	var lis = document.querySelectorAll('li');
+	for (var k = 0; k < lis.length; k++) lis[k].className = (k === i) ? 'active' : '';
+}
+
+function render() {
+	var ol = document.getElementById('list');
+	ol.innerHTML = '';
+	rows.forEach(function (r, i) {
+		var li = document.createElement('li');
+		li.innerHTML = '<span class="num">' + (i + 1) + '</span>' +
+			'<span class="t"></span><span class="s">' + (r.fmt || '') + ' ' + fmtSize(r.bytes || 0) + '</span>';
+		li.querySelector('.t').textContent = r.txt || ('#' + r.id);
+		li.onclick = function () { play(i); };
+		ol.appendChild(li);
+	});
+	var au = document.getElementById('au');
+	au.onended = function () { if (cur >= 0 && cur < rows.length - 1) play(cur + 1); };  // 自动连播
+	document.getElementById('cnt').textContent = '(' + rows.length + ' 首)';
+	document.getElementById('msg').style.display = 'none';
+}
+
+fetch(API + '?cmd=stats').then(function (r) { return r.json(); }).then(function (s) {
+	key = s.key;
+	loadList();
+}).catch(function (e) {
+	document.getElementById('msg').textContent = '服务不可用: ' + e;
+});
+
+function loadList() {
+	fetch(API + '?cmd=list&key=' + encodeURIComponent(key) + '&ch=music&since=0&limit=500')
+		.then(function (r) { return r.json(); }).then(function (j) {
+			if (!j.ok) throw new Error('list fail');
+			rows = (j.rows || []).reverse();   // 按上传先后正序显示
+			if (!rows.length) {
+				document.getElementById('msg').style.display = '';
+				document.getElementById('msg').textContent = '曲库为空: 点"上传歌曲"或把文件拖进本页, 也可 SMB 拖拷 \\\\HubIP\\hub\\music\\';
+				return;
+			}
+			render();
+		}).catch(function (e) {
+			document.getElementById('msg').textContent = '取列表失败: ' + e;
+		});
+}
+
+/* ============ 上传(浏览器选文件 / 拖拽), XHR 带进度 ============ */
+function uploadOne(file, ondone) {
+	var name = file.name.replace(/\.[^.]*$/, '');
+	var ext = (file.name.split('.').pop() || 'bin').toLowerCase();
+	var url = API + '?cmd=put&key=' + encodeURIComponent(key) +
+		'&dev=library&ch=music&dtype=file&fmt=' + encodeURIComponent(ext) +
+		'&uid=mu-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8) +
+		'&txt=' + encodeURIComponent(name);
+	var x = new XMLHttpRequest();
+	x.open('POST', url);
+	x.setRequestHeader('Content-Type', 'application/octet-stream');
+	x.upload.onprogress = function (e) {
+		if (e.lengthComputable)
+			setUpInfo('上传 "' + file.name + '" … ' + Math.round(e.loaded / e.total * 100) + '%');
+	};
+	x.onload = function () {
+		var ok = (x.status === 200 && x.responseText.indexOf('"ok":1') >= 0);
+		setUpInfo(ok ? '✓ 已入库: ' + name : '✗ 失败: ' + name);
+		ondone(ok);
+	};
+	x.onerror = function () { setUpInfo('✗ 网络错误: ' + file.name); ondone(false); };
+	x.send(file);
+}
+
+function setUpInfo(t) { document.getElementById('upinfo').textContent = t; }
+
+function uploadFiles(files) {
+	var arr = [].slice.call(files).filter(function (f) { return f.size > 0 && f.size < 52428800; });
+	if (!arr.length) return;
+	var i = 0;
+	(function next() {
+		if (i >= arr.length) { loadList(); return; }
+		uploadOne(arr[i++], next);
+	})();
+}
+
+document.getElementById('fi').onchange = function () {
+	uploadFiles(this.files);
+	this.value = '';
+};
+
+document.ondragover = function (e) { e.preventDefault(); return false; };
+document.ondrop = function (e) {
+	e.preventDefault();
+	if (!key) return;
+	uploadFiles(e.dataTransfer.files);
+	return false;
+};
+</script>
+</body>
+</html>
diff --git a/package/luci-app-gpiotest/Makefile b/package/luci-app-gpiotest/Makefile
new file mode 100644
index 0000000000..8ec2a4eca4
--- /dev/null
+++ b/package/luci-app-gpiotest/Makefile
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# luci-app-gpiotest — 网页试切任意 GPIO, 用来猜各 GPIO 的功能
+# 放到 OpenWrt SDK/源码的 package/luci-app-gpiotest/ 下
+
+include $(TOPDIR)/rules.mk
+
+LUCI_TITLE:=LuCI app to probe/toggle arbitrary GPIO lines
+# gpiod-tools 提供 gpioinfo(显示 consumer), 强烈建议一起装
+LUCI_DEPENDS:=+gpiod-tools
+LUCI_PKGARCH:=all
+
+PKG_VERSION:=1.0
+PKG_RELEASE:=1
+PKG_MAINTAINER:=you <you@example.com>
+PKG_LICENSE:=GPL-2.0-or-later
+
+include $(TOPDIR)/feeds/luci/luci.mk
+
+# 显式再装一次后端脚本并带上可执行位(防从 Windows 拷贝丢 +x)
+define Package/luci-app-gpiotest/install
+	$(call Package/luci-app-gpiotest/install/default,$(1))
+	$(INSTALL_DIR) $(1)/usr/bin
+	$(INSTALL_BIN) ./root/usr/bin/gpiotest $(1)/usr/bin/gpiotest
+endef
+
+# call BuildPackage - OpenWrt buildroot signature to enable feed for compile
diff --git a/package/luci-app-gpiotest/htdocs/luci-static/resources/view/gpiotest/main.js b/package/luci-app-gpiotest/htdocs/luci-static/resources/view/gpiotest/main.js
new file mode 100644
index 0000000000..11a6279faf
--- /dev/null
+++ b/package/luci-app-gpiotest/htdocs/luci-static/resources/view/gpiotest/main.js
@@ -0,0 +1,106 @@
+'use strict';
+'require view';
+'require fs';
+'require ui';
+'require poll';
+
+var BIN = '/usr/bin/gpiotest';
+
+function run(args) {
+	return fs.exec(BIN, args).then(function (r) {
+		return (r && typeof r.stdout === 'string') ? r.stdout : '';
+	}).catch(function (e) { return _('error: ') + e; });
+}
+
+return view.extend({
+	load: function () {
+		return Promise.all([ run(['info']), run(['list']) ]);
+	},
+
+	render: function (data) {
+		var infoEl = E('pre', { 'style': 'max-height:16em;overflow:auto;margin:0' }, data[0] || '');
+		var listEl = E('pre', { 'style': 'max-height:16em;overflow:auto;margin:0' }, data[1] || '');
+		var outEl  = E('pre', { 'style': 'margin:0' }, '');
+
+		function refresh() {
+			return Promise.all([ run(['info']), run(['list']) ]).then(function (d) {
+				infoEl.textContent = d[0] || '';
+				listEl.textContent = d[1] || '';
+			});
+		}
+
+		var lineIn = E('input', {
+			'type': 'text', 'placeholder': 'line #', 'style': 'width:6em',
+			'class': 'cbi-input-text'
+		});
+
+		function lineNo() {
+			var v = (lineIn.value || '').trim();
+			if (!/^[0-9]+$/.test(v)) { ui.addNotification(null, E('p', {}, _('Enter a numeric line number first')), 'warning'); return null; }
+			return v;
+		}
+
+		function act(cmd, extra, label) {
+			var l = lineNo(); if (l === null) return;
+			var args = [cmd, l]; if (extra !== undefined) args.push(extra);
+			return run(args).then(function (o) {
+				outEl.textContent = '$ gpiotest ' + args.join(' ') + '\n' + o;
+				ui.addNotification(null, E('p', {}, (label || cmd) + ' → line ' + l), 'info');
+				return refresh();
+			});
+		}
+
+		poll.add(refresh, 5);
+
+		var btn = function (cls, txt, fn) {
+			return E('button', { 'class': 'btn cbi-button ' + cls, 'click': fn }, txt);
+		};
+
+		return E('div', { 'class': 'cbi-map' }, [
+			E('h2', {}, _('GPIO Test / Probe')),
+			E('div', { 'class': 'cbi-map-descr' }, _('Toggle arbitrary GPIO lines to figure out what each one does. Line number = chip-relative index (same as gpioinfo / DTS <&gpio N>).')),
+
+			E('div', { 'class': 'alert-message warning' }, [
+				E('strong', {}, _('Warning: ')),
+				_('Blindly driving unknown GPIOs can hang the board or corrupt flash (reset lines, SPI chip-select, power enables). Lines already claimed by the kernel will refuse to export — that is expected protection. Prefer lines shown as "unused" in gpioinfo below.')
+			]),
+
+			E('div', { 'class': 'cbi-section' }, [
+				E('h3', {}, _('gpioinfo (direction + consumer of every line)')),
+				E('div', { 'class': 'cbi-section-descr' }, _('Lines with a named consumer are already used — no need to guess. "unused" lines are your probe candidates.')),
+				infoEl
+			]),
+
+			E('div', { 'class': 'cbi-section' }, [
+				E('h3', {}, _('Probe a line')),
+				E('div', { 'class': 'cbi-section-node' }, [
+					E('p', {}, [ _('Line number: '), lineIn ]),
+					E('div', {}, [
+						btn('cbi-button-action', _('Read'),        function () { act('get'); }),
+						' ',
+						btn('cbi-button-action', _('Set 1 (high)'),function () { act('set', '1', _('set 1')); }),
+						' ',
+						btn('cbi-button-action', _('Set 0 (low)'), function () { act('set', '0', _('set 0')); }),
+						' ',
+						btn('', _('Toggle'),      function () { act('toggle'); }),
+						' ',
+						btn('', _('As input'),    function () { act('in', undefined, _('input')); }),
+						' ',
+						btn('cbi-button-remove', _('Free (unexport)'), function () { act('free'); })
+					]),
+					E('h4', { 'style': 'margin-top:1em' }, _('Last command output')),
+					outEl
+				])
+			]),
+
+			E('div', { 'class': 'cbi-section' }, [
+				E('h3', {}, _('sysfs list (exported lines: direction / value)')),
+				listEl
+			])
+		]);
+	},
+
+	handleSave: null,
+	handleSaveApply: null,
+	handleReset: null
+});
diff --git a/package/luci-app-gpiotest/root/usr/bin/gpiotest b/package/luci-app-gpiotest/root/usr/bin/gpiotest
new file mode 100755
index 0000000000..2713ca7c47
--- /dev/null
+++ b/package/luci-app-gpiotest/root/usr/bin/gpiotest
@@ -0,0 +1,75 @@
+#!/bin/sh
+# gpiotest — 探测/试切任意 GPIO, 用来猜设备上各 GPIO 的功能
+# 用法:
+#   gpiotest info             gpioinfo: 每条线的 方向/consumer(已占用一目了然, 首选)
+#   gpiotest list             sysfs: base/ngpio 及各线 方向/电平
+#   gpiotest get    <line>    读某线当前值(不改方向)
+#   gpiotest in     <line>    设为输入并读回(用来找"按键/检测脚")
+#   gpiotest set    <line> 0|1  设为输出并置值(持久)
+#   gpiotest toggle <line>    翻转输出
+#   gpiotest free   <line>    unexport 释放该线
+#
+# line = gpiochip 内相对编号(和 gpioinfo/DTS 的 <&gpio N> 一致)。
+# 注意: 已被内核占用的线 export 会失败(自动保护); 乱切复位/flash 片选等可能死机,
+#       建议先看 info 里标 unused 的线再试。
+
+GC=$(ls -d /sys/class/gpio/gpiochip* 2>/dev/null | head -1)
+BASE=$(cat "$GC/base" 2>/dev/null)
+NG=$(cat "$GC/ngpio" 2>/dev/null)
+
+die(){ echo "$1" >&2; exit 1; }
+isnum(){ case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
+_nap(){ usleep 20000 2>/dev/null || sleep 1; }
+
+# 相对 line -> sysfs 目录, 确保 export
+_dir(){
+	isnum "$1" || die "line 必须是数字"
+	[ -n "$BASE" ] || die "no gpiochip (需内核 CONFIG_GPIO_SYSFS=y)"
+	[ "$1" -lt "${NG:-0}" ] 2>/dev/null || die "line 超范围(0..$((NG-1)))"
+	g=$((BASE + $1)); d=/sys/class/gpio/gpio$g
+	if [ ! -d "$d" ]; then
+		echo "$g" > /sys/class/gpio/export 2>/dev/null || \
+			die "line $1 (sys$g) 无法 export: 多半已被内核占用, 用 'info' 看 consumer"
+		_i=0; while [ ! -e "$d/direction" ] && [ $_i -lt 20 ]; do _i=$((_i+1)); _nap; done
+	fi
+	echo "$d"
+}
+
+# $1=sysfs目录  $2=in|out  (带回读校验+重试)
+_setdir(){
+	_i=0
+	while [ "$(cat "$1/direction" 2>/dev/null)" != "$2" ] && [ $_i -lt 20 ]; do
+		echo "$2" > "$1/direction" 2>/dev/null; _i=$((_i+1))
+		[ "$(cat "$1/direction" 2>/dev/null)" = "$2" ] && break
+		_nap
+	done
+	[ "$(cat "$1/direction" 2>/dev/null)" = "$2" ] || die "line 无法设为 $2 方向"
+}
+
+case "$1" in
+	info)
+		if command -v gpioinfo >/dev/null 2>&1; then gpioinfo
+		else echo "未安装 gpiod-tools(gpioinfo); 请 opkg install gpiod-tools" >&2; exit 1; fi ;;
+	list)
+		echo "gpiochip: ${GC:-?}  base=${BASE:-?}  ngpio=${NG:-?}"
+		n=0
+		while [ "$n" -lt "${NG:-0}" ]; do
+			g=$((BASE+n)); d=/sys/class/gpio/gpio$g
+			if [ -d "$d" ]; then
+				printf "line %2d (sys %d): dir=%-3s val=%s\n" "$n" "$g" \
+					"$(cat "$d/direction" 2>/dev/null)" "$(cat "$d/value" 2>/dev/null)"
+			else
+				printf "line %2d (sys %d): (未 export)\n" "$n" "$g"
+			fi
+			n=$((n+1))
+		done ;;
+	get)    d=$(_dir "$2") || exit 1; cat "$d/value" ;;
+	in)     d=$(_dir "$2") || exit 1; _setdir "$d" in;  cat "$d/value" ;;
+	set)    case "$3" in 0|1) :;; *) die "值只能 0 或 1";; esac
+	        d=$(_dir "$2") || exit 1; _setdir "$d" out; echo "$3" > "$d/value"; cat "$d/value" ;;
+	toggle) d=$(_dir "$2") || exit 1; _setdir "$d" out
+	        v=$(cat "$d/value"); echo $((1 - v)) > "$d/value"; cat "$d/value" ;;
+	free)   isnum "$2" || die "line 必须是数字"
+	        echo $((BASE + $2)) > /sys/class/gpio/unexport 2>/dev/null; echo freed ;;
+	*)      echo "usage: $0 info|list|get <l>|in <l>|set <l> 0|1|toggle <l>|free <l>" >&2; exit 2 ;;
+esac
