diff --git a/package/luci-app-usbswitch/root/usr/bin/usbsw b/package/luci-app-usbswitch/root/usr/bin/usbsw
new file mode 100755
index 0000000000..411a524781
--- /dev/null
+++ b/package/luci-app-usbswitch/root/usr/bin/usbsw
@@ -0,0 +1,66 @@
+#!/bin/sh
+# usbsw — SGM7227 USB 通道排查 (GPIO23 使能 + GPIO26 通道选择)
+#   注意: GPIO8(VBUS 供电) 现由 DTS 的 vbus-supply(regulator-always-on) 自动常供,
+#         不再手动控制(chipidea host 需要 regulator 管理 gpio8)。本脚本只管 23/26。
+#
+# 用法:
+#   通道 SEL(26):  usbsw host | pc | toggle | get
+#   使能 OE(23):   usbsw oe-on | oe-off | oe-toggle | oe-get
+#   组合:          usbsw status | usb-on(使能+切host) | usb-off
+#
+# 实测(2026-07): gpio26=1 => 切给 AR9331(路由器读U盘); gpio26=0 => 切给电脑
+HOST_VAL=1
+PC_VAL=0
+
+OE_LINE=23      # SGM7227 使能(OE)
+SEL_LINE=26     # SGM7227 通道选择(S)
+
+_nap() { usleep 20000 2>/dev/null || sleep 1; }
+
+# 相对 line -> sysfs 目录, 确保 export 且方向=output; 失败返回非 0
+_gpio_path() {
+	_gc=$(ls -d /sys/class/gpio/gpiochip* 2>/dev/null | head -1)
+	[ -n "$_gc" ] || { echo "no gpiochip (需内核 CONFIG_GPIO_SYSFS=y)" >&2; return 1; }
+	_base=$(cat "$_gc/base")
+	_g=$((_base + $1))
+	_d=/sys/class/gpio/gpio$_g
+
+	if [ ! -d "$_d" ]; then
+		echo "$_g" > /sys/class/gpio/export 2>/dev/null
+		_i=0
+		while [ ! -e "$_d/direction" ] && [ "$_i" -lt 20 ]; do _i=$((_i+1)); _nap; done
+	fi
+	_i=0
+	while [ "$(cat "$_d/direction" 2>/dev/null)" != "out" ] && [ "$_i" -lt 20 ]; do
+		echo out > "$_d/direction" 2>/dev/null
+		_i=$((_i+1)); [ "$(cat "$_d/direction" 2>/dev/null)" = "out" ] && break
+		_nap
+	done
+	[ "$(cat "$_d/direction" 2>/dev/null)" = "out" ] || { echo "gpio$_g: 无法设为 output" >&2; return 1; }
+	echo "$_d"
+}
+
+SEL_DIR=$(_gpio_path "$SEL_LINE") || exit 1
+OE_DIR=$(_gpio_path "$OE_LINE")   || OE_DIR=""
+
+_need() { [ -n "$1" ] || { echo "$2 未初始化(GPIO 被占用? 看 /sys/kernel/debug/gpio)" >&2; exit 1; } }
+_val()  { cat "$1/value" 2>/dev/null; }
+_set()  { echo "$2" > "$1/value"; }
+
+case "$1" in
+	host)   _set "$SEL_DIR" "$HOST_VAL" ;;
+	pc)     _set "$SEL_DIR" "$PC_VAL" ;;
+	toggle) v=$(_val "$SEL_DIR"); _set "$SEL_DIR" $((1 - v)) ;;
+	get)    _val "$SEL_DIR" ;;
+
+	oe-on|oe1)   _need "$OE_DIR" OE; _set "$OE_DIR" 1 ;;
+	oe-off|oe0)  _need "$OE_DIR" OE; _set "$OE_DIR" 0 ;;
+	oe-toggle)   _need "$OE_DIR" OE; v=$(_val "$OE_DIR"); _set "$OE_DIR" $((1 - v)); _val "$OE_DIR" ;;
+	oe-get)      _need "$OE_DIR" OE; _val "$OE_DIR" ;;
+
+	status)  echo "OE(gpio$OE_LINE)=$( [ -n "$OE_DIR" ] && _val "$OE_DIR" || echo NA )  SEL(gpio$SEL_LINE)=$(_val "$SEL_DIR")" ;;
+	usb-on)  _need "$OE_DIR" OE; _set "$OE_DIR" 1; _set "$SEL_DIR" "$HOST_VAL"; echo "usb-on: OE=1 SEL=host($HOST_VAL)" ;;
+	usb-off) _need "$OE_DIR" OE; _set "$OE_DIR" 0; echo "usb-off: OE=0" ;;
+
+	*)  echo "usage: $0 host|pc|toggle|get | oe-on|oe-off|oe-toggle|oe-get | status|usb-on|usb-off" >&2; exit 2 ;;
+esac
