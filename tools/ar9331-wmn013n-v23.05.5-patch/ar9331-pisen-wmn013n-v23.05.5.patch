diff --git a/package/luci-app-datahub/root/etc/init.d/datahub b/package/luci-app-datahub/root/etc/init.d/datahub
new file mode 100755
index 0000000000..3157771ecc
--- /dev/null
+++ b/package/luci-app-datahub/root/etc/init.d/datahub
@@ -0,0 +1,20 @@
+#!/bin/sh /etc/rc.common
+# datahub — 通用设备数据中枢
+# 开机: 后台等U盘挂载 → 建目录/库表/生成key; 注册每日维护 cron。
+
+START=97
+
+start() {
+	( /usr/bin/hub-init wait 45 || logger -t datahub "U盘初始化未完成, CGI将以503提示" ) &
+
+	# 每日 04:00 维护 + 每10分钟音乐库扫描 (幂等注册)
+	mkdir -p /etc/crontabs
+	grep -q hub-maint /etc/crontabs/root 2>/dev/null || \
+		echo "0 4 * * * /usr/bin/hub-maint" >> /etc/crontabs/root
+	grep -q hub-scan-music /etc/crontabs/root 2>/dev/null || \
+		echo "*/10 * * * * /usr/bin/hub-scan-music" >> /etc/crontabs/root
+	/etc/init.d/cron enable 2>/dev/null
+	/etc/init.d/cron restart 2>/dev/null
+}
+
+restart() { start; }
diff --git a/package/luci-app-datahub/root/etc/init.d/hub-announce b/package/luci-app-datahub/root/etc/init.d/hub-announce
new file mode 100755
index 0000000000..4208994ca3
--- /dev/null
+++ b/package/luci-app-datahub/root/etc/init.d/hub-announce
@@ -0,0 +1,15 @@
+#!/bin/sh /etc/rc.common
+# hub-announce — UDP 广播发现应答器(手表零配置找 hub)
+# 详见 /usr/bin/hub-announce 头部注释
+
+START=98
+USE_PROCD=1
+
+start_service() {
+	procd_open_instance
+	procd_set_param command /usr/bin/hub-announce
+	procd_set_param respawn 3600 5 0
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
diff --git a/package/luci-app-datahub/root/etc/uci-defaults/99-datahub-ksmbd b/package/luci-app-datahub/root/etc/uci-defaults/99-datahub-ksmbd
