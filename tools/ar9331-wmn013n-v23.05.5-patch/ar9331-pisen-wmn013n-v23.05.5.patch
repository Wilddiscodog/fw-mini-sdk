@@ -0,0 +1,87 @@
+#!/bin/sh
+# hub-init — datahub U盘初始化 (幂等, 开机自动执行)
+#
+# 用法:
+#   hub-init           确保U盘已挂载 + 目录/库表/key 就绪
+#   hub-init format    ★显式★ 把整块U盘格成 ext4 (会清空U盘, 需二次确认)
+#   hub-init wait [秒] 等待U盘出现并挂载 (开机时 USB 枚举有延迟)
+#
+# 挂载策略: block-mount 自动挂 /mnt/sda1 (无 fstab 配置时 block detect 生成)。
+
+MOUNT=$(uci -q get datahub.hub.mount || echo /mnt/sda1)
+ROOT="$MOUNT/hub"
+
+mounted() { grep -q " $MOUNT " /proc/mounts; }
+
+ensure_fstab() {  # 无本挂载点条目时 block detect 重建; 确保 enabled=1 并触发挂载
+	local i n
+	uci -q show fstab 2>/dev/null | grep -q "target='$MOUNT'" || \
+		block detect > /etc/config/fstab 2>/dev/null
+	n=$(uci -q show fstab 2>/dev/null | grep -c "=mount")
+	i=0
+	while [ "$i" -lt "$n" ]; do
+		if [ "$(uci -q get fstab.@mount[$i].target)" = "$MOUNT" ]; then
+			uci -q set fstab.@mount[$i].enabled='1'
+			uci commit fstab
+		fi
+		i=$((i+1))
+	done
+	uci -q show fstab 2>/dev/null | grep -q "target='$MOUNT'" || return 0
+	grep -q " $MOUNT " /proc/mounts || block mount 2>/dev/null
+	return 0
+}
+
+ensure_dirs() {
+	mkdir -p "$ROOT/db" "$ROOT/tmp" "$ROOT/data" || return 1
+	chmod 777 "$ROOT/tmp"
+	return 0
+}
+
+ensure_schema() {
+	[ -f "$ROOT/db/datahub.db" ] && return 0
+	sqlite3 "$ROOT/db/datahub.db" < /usr/share/datahub/schema.sql
+}
+
+ensure_key() {  # 首次生成随机 key (之后固定, LuCI状态页可查)
+	k=$(uci -q get datahub.hub.key)
+	[ -n "$k" ] && return 0
+	k=$(head -c 8 /dev/urandom | md5sum | cut -c1-16)
+	uci set datahub.hub.key="$k"
+	uci commit datahub
+}
+
+case "$1" in
+format)
+	echo "!!! 将把 $MOUNT 所在整块U盘格式化为 ext4, 所有数据丢失 !!!"
+	printf "输入 YES 确认: "; read r
+	[ "$r" = "YES" ] || { echo "已取消"; exit 1; }
+	# 找到挂载点所在设备
+	dev=$(mount | awk -v m="$MOUNT" '$3==m{print $1}')
+	[ -n "$dev" ] || { echo "未找到设备 (U盘未挂载在 $MOUNT)"; exit 1; }
+	umount "$MOUNT" || exit 1
+	echo "mkfs.ext4 $dev ..."
+	mkfs.ext4 -F "$dev" || exit 1
+	mount "$dev" "$MOUNT" || block mount
+	echo "格式化完成, 重新初始化..."
+	shift; exec "$0"
+	;;
+wait)
+	t=${2:-30}; i=0
+	while [ $i -lt "$t" ]; do
+		mounted && ensure_fstab && mounted && exit 0
+		sleep 1; i=$((i+1))
+	done
+	exit 1
+	;;
+esac
+
+# 默认: 全套幂等初始化
+i=0
+while [ $i -lt 20 ]; do
+	mounted || { ensure_fstab; sleep 1; i=$((i+1)); continue; }
+	ensure_dirs && ensure_schema && ensure_key && exit 0
+	sleep 1; i=$((i+1))
+done
+
+logger -t datahub "hub-init: U盘未就绪 (等了${i}s), 稍后由CGI报503"
+exit 1
diff --git a/package/luci-app-datahub/root/usr/bin/hub-maint b/package/luci-app-datahub/root/usr/bin/hub-maint
