index 0000000000..73157c2499
--- /dev/null
+++ b/package/luci-app-datahub/Makefile
@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+#
+# luci-app-datahub — 通用家庭设备数据中枢
+#   U盘(ext4) + SQLite 数据湖 + CGI API(/cgi-bin/hub) + SMB网络备份 + LuCI状态页
+#   对讲机/传感器/任意自制设备经 HTTP 接入: put/list/get/ack/stats/export
+
+include $(TOPDIR)/rules.mk
+
+LUCI_TITLE:=Device Data Hub (SQLite + CGI API + SMB backup + status page)
+LUCI_DEPENDS:=+sqlite3-cli +socat
+LUCI_PKGARCH:=all
+
+PKG_VERSION:=1.0
+PKG_RELEASE:=1
+PKG_MAINTAINER:=100ask <you@example.com>
+PKG_LICENSE:=GPL-2.0-or-later
+
+include $(TOPDIR)/feeds/luci/luci.mk
+
+# 显式安装脚本/CGI并带可执行位 (照 luci-app-usbswitch 的做法)
+define Package/luci-app-datahub/install
+	$(call Package/luci-app-datahub/install.default,$(1))
+	$(INSTALL_DIR) $(1)/usr/bin $(1)/usr/share/datahub \
+		$(1)/etc/init.d $(1)/etc/uci-defaults $(1)/www/cgi-bin
+	$(INSTALL_BIN) ./root/www/cgi-bin/hub $(1)/www/cgi-bin/hub
+	$(INSTALL_DATA) ./root/www/music.html $(1)/www/music.html
+	$(INSTALL_BIN) ./root/usr/bin/hub-init $(1)/usr/bin/hub-init
+	$(INSTALL_BIN) ./root/usr/bin/hub-maint $(1)/usr/bin/hub-maint
+	$(INSTALL_BIN) ./root/usr/bin/hub-scan-music $(1)/usr/bin/hub-scan-music
+	$(INSTALL_BIN) ./root/usr/bin/hub-announce $(1)/usr/bin/hub-announce
+	$(INSTALL_BIN) ./root/usr/bin/hub-announce-reply $(1)/usr/bin/hub-announce-reply
+	$(INSTALL_BIN) ./root/etc/init.d/datahub $(1)/etc/init.d/datahub
+	$(INSTALL_BIN) ./root/etc/init.d/hub-announce $(1)/etc/init.d/hub-announce
+	$(INSTALL_BIN) ./root/etc/uci-defaults/99-datahub-ksmbd $(1)/etc/uci-defaults/99-datahub-ksmbd
+	$(INSTALL_DATA) ./root/usr/share/datahub/schema.sql $(1)/usr/share/datahub/schema.sql
+	$(INSTALL_DATA) ./root/etc/config/datahub $(1)/etc/config/datahub
+endef
+
+# call BuildPackage — OpenWrt buildroot 发现包的签名(luci.mk 内部完成真正的 BuildPackage)
diff --git a/package/luci-app-datahub/htdocs/luci-static/resources/view/datahub/main.js b/package/luci-app-datahub/htdocs/luci-static/resources/view/datahub/main.js
new file mode 100644
index 0000000000..e0f0e5931f
--- /dev/null
+++ b/package/luci-app-datahub/htdocs/luci-static/resources/view/datahub/main.js
@@ -0,0 +1,185 @@
+'use strict';
+'require view';
+'require request';
+'require poll';
+
+// datahub 状态页: 存储概览 / 设备表 / 通道统计 / 最新动态 / 接入信息与备份导出
+// 数据源: /cgi-bin/hub?cmd=stats (同源, 免key只读), 10秒自动刷新
+
+var API = '/cgi-bin/hub?cmd=stats';
+
+function fmtSize(n) {
+	if (n == null || isNaN(n)) return '-';
+	n = Number(n);
+	if (n >= 1073741824) return (n / 1073741824).toFixed(1) + ' GB';
+	if (n >= 1048576)    return (n / 1048576).toFixed(1) + ' MB';
+	if (n >= 1024)       return (n / 1024).toFixed(1) + ' KB';
+	return n + ' B';
+}
+
+function fmtTime(ts) {
+	if (!ts || ts <= 0) return '-';
+	var d = new Date(ts * 1000);
+	function p(x) { return (x < 10 ? '0' : '') + x; }
+	return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' +
+		p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
+}
+
+function ago(ts, now) {
+	if (!ts || ts <= 0) return '-';
+	var s = now - ts;
+	if (s < 60)    return s + ' 秒前';
+	if (s < 3600)  return Math.floor(s / 60) + ' 分钟前';
+	if (s < 86400) return Math.floor(s / 3600) + ' 小时前';
+	return Math.floor(s / 86400) + ' 天前';
+}
+
+function th(t) { return E('th', { 'class': 'th' }, t); }
+function td(t) { return E('td', { 'class': 'td' }, (t == null || t === '') ? '-' : '' + t); }
+
+function kvCard(title, entries) {
+	var tds = entries.map(function (e) {
+		return E('div', { 'class': 'td left', 'style': 'width:' + Math.floor(100 / entries.length) + '%' }, [
+			E('small', {}, e[0]), E('br'), E('strong', {}, e[1])
+		]);
+	});
+	return E('div', { 'class': 'cbi-section' }, [
+		E('h3', {}, title),
+		E('div', { 'class': 'table' }, [ E('div', { 'class': 'tr' }, tds) ])
+	]);
+}
+
+function buildBody(data) {
+	var now = data.now || Math.floor(Date.now() / 1000);
+	var diskUsed = (data.disk && data.disk.total) ? (data.disk.total - data.disk.free) : 0;
+	var chMap = {};
+	(data.channels || []).forEach(function (c) { chMap[c.channel] = c.records; });
+	var chStr = Object.keys(chMap).map(function (k) { return k + ': ' + chMap[k]; }).join('　') || '-';
+	var host = location.hostname;
+
+	var devRows = (data.devices || []).map(function (d) {
+		return E('tr', { 'class': 'tr' }, [
+			td(d.name || d.devid),
+			td(d.name ? d.devid : ''),
+			td(d.kind || 'generic'),
+			td(d.records),
+			td(ago(d.last_seen, now))
+		]);
+	});
+
+	var recRows = (data.recent || []).map(function (r) {
+		var content;
+		if (r.dtype === 'file') {
+			content = E('span', {}, [
+				(r.fmt || '?') + (r.dur_ms ? ' ' + Math.round(r.dur_ms / 1000) + 's ' : ' ') +
+					fmtSize(r.bytes) + '  ',
+				E('a', {
+					'href': '/cgi-bin/hub?cmd=get&key=' + encodeURIComponent(data.key || '') + '&id=' + r.id,
+					'target': '_blank'
+				}, [ '▶ ' + _('播放') ])
+			]);
+		} else {
+			content = E('span', {}, (r.val != null ? r.val : '') + ((r.val != null && r.txt) ? ' ' : '') + (r.txt || ''));
+		}
+		return E('tr', { 'class': 'tr' }, [
+			td(fmtTime(r.ts)), td(r.devid), td(r.channel),
+			E('td', { 'class': 'td' }, [ content ])
+		]);
+	});
+
+	return [
+		kvCard(_('存储'), [
+			[ _('U盘已用 / 总量'), fmtSize(diskUsed * 1024) + ' / ' + fmtSize((data.disk || {}).total * 1024) ],
+			[ _('数据库 / 快照'), fmtSize(data.db_bytes) + ' / ' + fmtSize(data.bak_bytes) ],
+			[ _('上次快照'), fmtTime(data.bak_ts) ]
+		]),
+		kvCard(_('数据'), [
+			[ _('记录总数'), data.records ],
+			[ _('最近24小时'), data.today ],
+			[ _('设备数'), (data.devices || []).length ],
+			[ _('通道分布'), chStr ]
+		]),
+		E('div', { 'class': 'cbi-section' }, [
+			E('h3', {}, _('设备')),
+			E('table', { 'class': 'table' }, [
+				E('tr', { 'class': 'tr table-titles' }, [
+					th(_('名称')), th(_('ID')), th(_('类型')), th(_('记录数')), th(_('最后在线'))
+				])
+			].concat(devRows.length ? devRows : [ E('tr', { 'class': 'tr' }, [
+				E('td', { 'class': 'td center', 'colspan': 5 }, _('暂无设备 — 让设备先 POST 一条数据即自动注册'))
+			]) ]))
+		]),
+		E('div', { 'class': 'cbi-section' }, [
+			E('h3', {}, _('最新动态')),
+			E('table', { 'class': 'table' }, [
+				E('tr', { 'class': 'tr table-titles' }, [
+					th(_('时间')), th(_('设备')), th(_('通道')), th(_('内容'))
+				])
+			].concat(recRows.length ? recRows : [ E('tr', { 'class': 'tr' }, [
+				E('td', { 'class': 'td center', 'colspan': 4 }, _('暂无记录'))
+			]) ]))
+		]),
+		E('div', { 'class': 'cbi-section' }, [
+			E('h3', {}, _('接入与备份')),
+			E('div', { 'class': 'cbi-section-node' }, [
+				E('p', {}, [
+					_('设备 API 密钥') + ': ', E('code', {}, data.key || '-'),
+					'　(IP: ' + host + ', mDNS: ' + 'Hub-xxxx.local)'
+				]),
+				E('p', {}, [
+					_('接口') + ': ', E('code', {}, 'http://' + host + '/cgi-bin/hub?cmd=put&key=' + (data.key || 'KEY') + '&dev=设备ID&ch=通道&val=数值'),
+					E('br'),
+					_('SMB 备份') + ': ', E('code', {}, '\\\\' + host + '\\hub') + ' (' + _('账号 hub') + ')'
+				]),
+				E('div', {}, [
+					E('button', {
+						'class': 'btn cbi-button cbi-button-action',
+						'click': function () { window.open('/cgi-bin/hub?cmd=export&days=7', '_blank'); }
+					}, _('导出备份 (DB快照 + 近7天附件)'))
+				])
+			])
+		])
+	];
+}
+
+return view.extend({
+	load: function () {
+		return request.get(API).then(function (res) {
+			try { return res.json(); } catch (e) { return { ok: 0, err: 'bad response' }; }
+		}).catch(function () { return { ok: 0, err: 'unreachable' }; });
+	},
+
+	render: function (data) {
+		var container = E('div', { 'class': 'cbi-map' }, [ E('h2', {}, _('Data Hub 数据中枢')) ]);
+		var body = E('div');
+
+		function refresh(d) {
+			body.innerHTML = '';
+			if (d && d.ok === 1) {
+				buildBody(d).forEach(function (el) { body.appendChild(el); });
+			} else {
+				body.appendChild(E('div', { 'class': 'alert-message warning' }, [
+					E('p', {}, _('服务未就绪') + ': ' + ((d && d.err) || '?')),
+					E('p', {}, _('排查: U盘是否插入且 USB 通道为 host? SSH 运行 hub-init 与 logread|grep datahub。'))
+				]));
+			}
+		}
+
+		refresh(data);
+		container.appendChild(body);
+
+		poll.add(function () {
+			return request.get(API).then(function (res) {
+				try { return res.json(); } catch (e) { return null; }
+			}).catch(function () { return null; }).then(function (d) {
+				if (d) refresh(d);
+			});
+		}, 10);
+
+		return container;
+	},
+
+	handleSaveApply: null,
+	handleSave: null,
+	handleReset: null
+});
diff --git a/package/luci-app-datahub/root/etc/config/datahub b/package/luci-app-datahub/root/etc/config/datahub
