+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# luci-app-usbswitch — 网页按钮切换 USB 通道 (SGM7227, GPIO26)
+# 放到 OpenWrt SDK/源码的 package/luci-app-usbswitch/ 下
+
+include $(TOPDIR)/rules.mk
+
+LUCI_TITLE:=LuCI support for switching USB channel (SGM7227 GPIO26)
+LUCI_DEPENDS:=
+LUCI_PKGARCH:=all
+
+PKG_VERSION:=1.0
+PKG_RELEASE:=2
+PKG_MAINTAINER:=you <you@example.com>
+PKG_LICENSE:=GPL-2.0-or-later
+
+include $(TOPDIR)/feeds/luci/luci.mk
+
+# 显式安装脚本/服务并带可执行位（避免拷贝丢失 +x）
+define Package/luci-app-usbswitch/install
+	$(call Package/luci-app-usbswitch/install/default,$(1))
+	$(INSTALL_DIR) $(1)/usr/bin $(1)/etc/init.d $(1)/etc/uci-defaults
+	$(INSTALL_BIN) ./root/usr/bin/usbsw $(1)/usr/bin/usbsw
+	$(INSTALL_BIN) ./root/etc/init.d/usbdefault $(1)/etc/init.d/usbdefault
+	$(INSTALL_BIN) ./root/etc/uci-defaults/99-luci-app-usbswitch $(1)/etc/uci-defaults/99-luci-app-usbswitch
+endef
+
+# call BuildPackage - OpenWrt buildroot signature to enable feed for compile
diff --git a/package/luci-app-usbswitch/htdocs/luci-static/resources/view/usbswitch/main.js b/package/luci-app-usbswitch/htdocs/luci-static/resources/view/usbswitch/main.js
